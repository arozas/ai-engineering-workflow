{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow installation metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowName", "workflowVersion", "installationMode", "shareProjectContext", "localExcludedPaths", "installedAtUtc", "managedFiles"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "workflowName": { "const": "ai-engineering-workflow" },
    "workflowVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "installationMode": { "enum": ["local", "shared"] },
    "shareProjectContext": { "type": "boolean" },
    "localExcludedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "installedAtUtc": { "type": "string", "format": "date-time" },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "installationMode": { "const": "local" } },
        "required": ["installationMode"]
      },
      "then": {
        "properties": { "localExcludedPaths": { "minItems": 1 } }
      },
      "else": {
        "properties": {
          "shareProjectContext": { "const": false },
          "localExcludedPaths": { "maxItems": 0 }
        }
      }
    }
  ]
}
