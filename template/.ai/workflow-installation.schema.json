{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow installation metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowName", "workflowVersion", "installedAtUtc", "managedFiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workflowName": { "const": "ai-engineering-workflow" },
    "workflowVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "installedAtUtc": { "type": "string", "format": "date-time" },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
