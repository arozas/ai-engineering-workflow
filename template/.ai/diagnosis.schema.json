{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow production diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "summary",
    "impact",
    "evidence",
    "hypotheses",
    "reproduction",
    "rootCause",
    "regressionTest",
    "missingEvidence",
    "mitigationOptions",
    "escalationReason",
    "safety"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "status": { "enum": ["BLOCKED", "ROOT_CAUSE_CONFIRMED", "ESCALATED"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "affectedUsers", "firstObservedUtc", "affectedVersions"],
      "properties": {
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
        "affectedUsers": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "firstObservedUtc": { "type": ["string", "null"], "format": "date-time" },
        "affectedVersions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source", "observation", "sanitized"],
        "properties": {
          "id": { "type": "string", "pattern": "^E[1-9][0-9]*$" },
          "type": { "enum": ["incident-report", "log", "metric", "trace", "deployment", "repository", "reproduction", "test", "other"] },
          "source": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "observation": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "sanitized": { "const": true }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "supportingEvidenceIds", "contradictingEvidenceIds", "falsificationTest", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^H[1-9][0-9]*$" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "status": { "enum": ["OPEN", "REJECTED", "CONFIRMED"] },
          "supportingEvidenceIds": { "$ref": "#/$defs/evidenceIds" },
          "contradictingEvidenceIds": { "$ref": "#/$defs/evidenceIds" },
          "falsificationTest": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "result": { "type": ["string", "null"], "maxLength": 4000 }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "steps", "evidenceIds"],
      "properties": {
        "status": { "enum": ["REPRODUCED", "PARTIAL", "NOT_REPRODUCED", "NOT_ATTEMPTED"] },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "rootCause": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["statement", "confidence", "evidenceIds"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 3000 },
        "confidence": { "enum": ["HIGH", "MEDIUM"] },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "regressionTest": { "type": ["string", "null"], "maxLength": 2000 },
    "missingEvidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "mitigationOptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "escalationReason": { "type": ["string", "null"], "maxLength": 2000 },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionMutationPerformed", "secretsAccessed"],
      "properties": {
        "productionMutationPerformed": { "const": false },
        "secretsAccessed": { "const": false }
      }
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^E[1-9][0-9]*$" },
      "uniqueItems": true
    }
  }
}
