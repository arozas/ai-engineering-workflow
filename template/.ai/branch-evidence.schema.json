{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow branch-creation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "previousBranch", "branch", "sha", "result", "createdAtUtc"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "previousBranch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "branch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "result": { "const": "BRANCH_CREATED" },
    "createdAtUtc": { "type": "string", "format": "date-time" }
  }
}
