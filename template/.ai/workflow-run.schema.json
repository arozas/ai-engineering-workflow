{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow persisted run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "workflowPath",
    "taskType",
    "status",
    "baseSha",
    "currentSha",
    "correctionIterations",
    "maximumCorrectionIterations",
    "createdAtUtc",
    "updatedAtUtc",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "workflowPath": { "enum": ["standard", "fast-path", "diagnostic"] },
    "taskType": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": {
      "enum": [
        "PLANNING",
        "PLAN_APPROVED",
        "IMPLEMENTING",
        "GATES_PASSED",
        "GATE_FAILED",
        "REVIEW_FAILED",
        "READY_FOR_DELIVERY",
        "COMMITTED",
        "PUBLISHED",
        "DRAFT_PR_CREATED",
        "DIAGNOSING",
        "DIAGNOSIS_BLOCKED",
        "ROOT_CAUSE_CONFIRMED",
        "ESCALATED"
      ]
    },
    "baseSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|UNBORN)$" },
    "currentSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|UNBORN)$" },
    "worktreeFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "controlPlaneFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "qualityPlan": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/qualityPlan" }
      ]
    },
    "correctionIterations": { "type": "integer", "minimum": 0, "maximum": 3 },
    "maximumCorrectionIterations": { "type": "integer", "minimum": 1, "maximum": 3 },
    "diagnosticIterations": { "type": "integer", "minimum": 0, "maximum": 3 },
    "maximumDiagnosticIterations": { "type": "integer", "minimum": 1, "maximum": 3 },
    "sourceRunId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "escalationReason": { "type": ["string", "null"], "maxLength": 2000 },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/artifact" },
      "required": ["requirement"]
    }
  },
  "$defs": {
    "qualityPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affectedModuleIds", "projectSha256", "matrixSha256"],
      "properties": {
        "affectedModuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "projectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "matrixSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^\\/]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "verdict": { "enum": ["PASS", "FAIL", "ESCALATE"] }
      }
    }
  }
}
