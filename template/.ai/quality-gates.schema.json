{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow deterministic quality-gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAtUtc",
    "completedAtUtc",
    "projectPath",
    "projectSha256",
    "runnerSha256",
    "qualityPlanSha256",
    "startedWorktreeFingerprint",
    "worktreeFingerprint",
    "worktreeStable",
    "overall",
    "modules"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "projectPath": { "const": ".ai/project.json" },
    "projectSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runnerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "qualityPlanSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "startedWorktreeFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "worktreeFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "worktreeStable": { "type": "boolean" },
    "overall": { "enum": ["PASS", "FAIL", "INCOMPLETE_CONFIGURATION", "BLOCKED_REPOSITORY_HYGIENE", "CONTROL_PLANE_OUTPUT", "PLAN_INVALIDATED"] },
    "repositoryHygiene": { "$ref": "#/$defs/repositoryHygiene" },
    "planScope": { "$ref": "#/$defs/planScope" },
    "worktreeChanges": { "$ref": "#/$defs/worktreeChanges" },
    "controlPlaneOutputPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "workingDirectory", "status", "exitCode", "durationMilliseconds", "timedOut", "stdout", "stderr", "outputTruncated"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "exitCode": { "type": ["integer", "null"] },
        "durationMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
        "timedOut": { "type": "boolean" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "outputTruncated": { "type": "boolean" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "commands"],
      "properties": {
        "name": { "enum": ["restore", "build", "lint", "typecheck", "test", "e2e"] },
        "status": { "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_CONFIGURED"] },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "overall", "configuredCommandCount", "phases"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "minLength": 1 },
        "overall": { "enum": ["PASS", "FAIL", "INCOMPLETE_CONFIGURATION", "BLOCKED"] },
        "configuredCommandCount": { "type": "integer", "minimum": 0 },
        "phases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/phase" }
        }
      }
    },
    "hygieneIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "enum": ["TRACKED_GENERATED_ARTIFACT", "GENERATED_PATH_NOT_IGNORED"] },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "repositoryHygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "issues"],
      "properties": {
        "status": { "enum": ["PASS", "BLOCKED"] },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/hygieneIssue" } }
      }
    },
    "planScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unexpectedPaths", "missingPaths"],
      "properties": {
        "status": { "enum": ["PASS", "INVALID"] },
        "unexpectedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "missingPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "pathSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackedCount", "untrackedCount", "tracked", "untracked", "truncated"],
      "properties": {
        "trackedCount": { "type": "integer", "minimum": 0 },
        "untrackedCount": { "type": "integer", "minimum": 0 },
        "tracked": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "untracked": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "truncated": { "type": "boolean" }
      }
    },
    "worktreeChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "addedDuringRun", "removedDuringRun"],
      "properties": {
        "before": { "$ref": "#/$defs/pathSnapshot" },
        "after": { "$ref": "#/$defs/pathSnapshot" },
        "addedDuringRun": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "removedDuringRun": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
