{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow draft pull-request evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "number",
    "url",
    "base",
    "head",
    "headSha",
    "title",
    "draft",
    "state",
    "createdAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "number": { "type": "integer", "minimum": 1 },
    "url": { "type": "string", "format": "uri" },
    "base": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "head": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$" },
    "draft": { "const": true },
    "state": { "const": "OPEN" },
    "createdAtUtc": { "type": "string", "format": "date-time" }
  }
}
