{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Engineering Workflow commit evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "sha", "parentSha", "branch", "files", "message", "committedAtUtc"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "parentSha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|UNBORN)$" },
    "branch": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?![A-Za-z]:[\\/])(?![\\/])(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+$" }
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "committedAtUtc": { "type": "string", "format": "date-time" }
  }
}
