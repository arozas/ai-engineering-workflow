{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-engineering-workflow/project.schema.json",
  "title": "AI Engineering Workflow project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "modules"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 3, "default": 3 },
        "diffBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "filesMultiplier": { "type": "number", "minimum": 1, "default": 2 },
            "linesMultiplier": { "type": "number", "minimum": 1, "default": 3 }
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workItems": { "$ref": "#/$defs/workItems" }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["restore", "build", "lint", "typecheck", "test", "e2e"],
      "properties": {
        "restore": { "$ref": "#/$defs/commands" },
        "build": { "$ref": "#/$defs/commands" },
        "lint": { "$ref": "#/$defs/commands" },
        "typecheck": { "$ref": "#/$defs/commands" },
        "test": { "$ref": "#/$defs/commands" },
        "e2e": { "$ref": "#/$defs/commands" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "languages", "frameworks", "architectures", "contextSkills", "quality"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "minLength": 1 },
        "languages": { "$ref": "#/$defs/stringList" },
        "frameworks": { "$ref": "#/$defs/stringList" },
        "architectures": { "$ref": "#/$defs/stringList" },
        "contextSkills": { "$ref": "#/$defs/stringList" },
        "quality": { "$ref": "#/$defs/quality" }
      }
    },
    "workItems": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "organization", "project"],
      "properties": {
        "provider": { "const": "azure-devops" },
        "organization": { "type": "string", "pattern": "^https://dev\\.azure\\.com/[^/]+/?$" },
        "project": { "type": "string", "minLength": 1 }
      }
    }
  }
}
