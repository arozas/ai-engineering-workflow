{
  "id": "react-vite",
  "description": "Create a React and TypeScript application using the official Vite generator",
  "stacks": ["node", "react"],
  "networkRequired": true,
  "commands": [
    {
      "executable": "npm",
      "arguments": ["create", "vite@latest", ".", "--", "--template", "react-ts"],
      "workingDirectory": "{{target}}",
      "environment": {
        "npm_config_yes": "true"
      }
    }
  ]
}
